bashate_read_config() {
    local f_cfg_file="$1"
    local value

    if [[ -f $f_cfg_file ]]; then
        value=$(sed -n 's/^bashate_line_length=//p' "$f_cfg_file")
        [[ -n $value ]] && {
            bashate_line_length="$value"
        }
        value=$(sed -n 's/^bashate_ignore=//p' "$f_cfg_file")
        [[ -n $value ]] && {
            bashate_ignore="$value"
        }
    fi
}

bashate_gather_config() {
    #
    # Provides (empty if unset):
    #  bashate_line_length
    #  bashate_ignore

    bashate_line_length=""
    bashate_ignore=""

    bashate_read_config "$olint_cfg_default"
    bashate_read_config "$olint_cfg_proj"
}

