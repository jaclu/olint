override_cmd() {
    local linter_override="$1"
    local cmd_ok="$2"

    linter_cmd["$linter_override"]="$cmd_ok"
}

override_proj_cmd() {
    local linter_override="$1"
    local cmd_ok="$2"

    proj_linter_cmd["$linter_override"]="$cmd_ok"
}

process_linter_overrides() {
    local linter_override
    local new_cmd
    local cmd_ok

    log_it "process_linter_overrides()" "$dbglvl_major_tasks"
    for linter_override in "${!override_linter_cmd[@]}"; do
        if ! str_in_array "$linter_override" "${linter_order[@]}" \
            && ! str_in_array "$linter_override" "${proj_linters[@]}"; then

            # linter not used, ignore override
            continue
        fi
        new_cmd="${override_linter_cmd[$linter_override]}"
        log_it "linter: $linter_override  - override command: $new_cmd" \
            "$dbglvl_lintscan_details"
        [[ -z "$new_cmd" ]] && {
            error_msg "override_linter_cmd[$linter_override]= - command not defined"
        }
        cmd_ok="$(verify_lint_cmd "$new_cmd")"
        [[ -z "$cmd_ok" ]] && {
            error_msg "override_linter_cmd[$linter_override]=$new_cmd - command not found"
        }
        if str_in_array "$linter_override" "${linter_order[@]}"; then
            override_cmd "$linter_override" "$cmd_ok"
        elif str_in_array "$linter_override" "${proj_linters[@]}"; then
            override_proj_cmd "$linter_override" "$cmd_ok"
        fi
    done
    # echo "process_linter_overrides() - done"
}

check_linter_plugins() {
    local d_plugins="$1"
    local dbg_indent=$dbg_indent
    local f_plugin plugin_name
    local f_plugin_override
    local plugins_found=0
    local unsorted
    local sorted_items

    if [[ -z $d_plugins ]]; then
        error_msg "check_linter_plugins() - called with no param"
    elif [[ ! -d $d_plugins ]]; then
        error_msg "Plugin folder missing: $d_plugins"
    fi

    log_it "Inspecting plugins in: $d_plugins" 1
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    [[ "$d_plugins" != "$default_olint_plugin_dir" ]] && {
        printf '\n***  Using non-default plugin folder: %s\n\n' "$(realpath "$d_plugins")"
    }
    # Loop through each file in alphabetical order, adding those where cmd is installed
    for f_plugin in "$d_plugins"/*; do
        [[ -d $f_plugin ]] && continue

        # skip files ending with ~
        [[ ${f_plugin%"~"} != "$f_plugin" ]] && continue

        plugin_name="${f_plugin##*/}" # same but faster than basename
        f_plugin_override="$d_plugin_overrides/$plugin_name"
        [[ -f $f_plugin_override ]] && {
            # points prel_plugin_check to this alt file
            f_plugin="$f_plugin_override"
        }
        # [[ "$plugin_name" = "ruff-check" ]] && {
        #     log_it "hepp"
        # }
        if prel_plugin_check "$f_plugin"; then
            valid_plugins+=("$plugin_name")
            # log_it "Added plugin: $plugin_name"
        else
            log_it "Rejected plugin: $plugin_name"
        fi
    done
    # at this point all plugins listed in valid_plugins has its cmd/proj_cmd present

    log_it "-- processing valid plugins: ${valid_plugins[*]}" "$dbglvl_major_tasks"
    for plugin_name in "${valid_plugins[@]}"; do
        log_it "processing plugin: $plugin_name" "$dbglvl_lintscan_details"
        f_plugin_override="$d_plugin_overrides/$plugin_name"
        if [[ -f $f_plugin_override ]]; then
            log_it "using plugin_override: $f_plugin_override" "$dbglvl_major_tasks"
            f_plugin="$f_plugin_override"
        else
            f_plugin="$d_plugins/$plugin_name"
        fi
        parse_plugin_file "$f_plugin" && plugins_found=1
    done
    [[ $plugins_found -eq 0 ]] && {
        error_msg "No plugins found in: $d_plugins"
    }
    log_it "-- plugins that will be used: ${valid_plugins[*]}"
    process_linter_overrides

    # Sort project linters
    unsorted=("${proj_linters[@]}")
    sorted_items="$(sort_linters unsorted)"
    # shellcheck disable=SC2206 # in this case the string should be split
    proj_linters=($sorted_items)

    [[ $verbosity_lvl -ge 1 ]] && echo " done!"
}

apply_linter_skips() {
    local i j found=0
    for i in "${!unskip_linters[@]}"; do
        for j in "${!skip_linters[@]}"; do
            if [[ ${skip_linters[j]} == "${unskip_linters[i]}" ]]; then
                unset 'skip_linters[j]'
                found=1
            fi
        done
    done
    [[ "$found" = 1 ]] && skip_linters=("${skip_linters[@]}") # repack, keep tidy for iteration/printing
}

prel_plugin_check() {
    # excluded plugins have already been filtered out,
    # now just check if plugin has a cmd, if cmd exists, return plugin name
    local f_plugin="$1"
    local plugin_name="${f_plugin##*/}" # same but faster than basename

    # encapsulate all f_plugin variables, so that they dont leak
    local disabled_by=() # initiate as empty list
    local plugin_cmd plugin_cmd_actual proj_plugin_cmd
    local plugin_priority=50 # set a default priority, higher prios are run first
    local plugin_extensions plugin_file_types
    local ruff_change_code="$ruff_change_code"
    local shfmt_change_code="$shfmt_change_code"
    local use_isort_style_import_ordering="$use_isort_style_import_ordering"

    [[ -z "$f_plugin" ]] && {
        error_msg "prel_plugin_check() - no param"
    }
    log_it "prel_plugin_check($f_plugin)" "$dbglvl_all_detils"
    [[ " ${skip_linters[*]} " == *" $plugin_name "* ]] && {
        log_it "$plugin_name is listed to be skipped" "$dbglvl_lintscan_basic"
        return 1
    }

    source_file "$f_plugin" || return 1

    [[ -z "$proj_plugin_cmd" ]] && [[ -z "$plugin_cmd" ]] && {
        error_msg "Neither plugin_cmd nor proj_plugin_cmd found: $f_plugin"
    }

    if [[ " ${project_linters[*]} " == *" $plugin_name "* ]]; then
        [[ -z "$proj_plugin_cmd" ]] && {
            # proj command not found - linter not installed/available
            error_msg "$plugin_name - requested as proj linter, no proj_plugin_cmd defined"
        }
        [[ -z "$(verify_lint_cmd "$proj_plugin_cmd")" ]] && {
            # command not found - linter not installed
            return 1
        }
    else
        [[ -z "$plugin_cmd" ]] && {
            error_msg "Plugin $f_plugin - Not listed as project linter and no plugin_cmd"
        }
        [[ -n "$(verify_lint_cmd "$plugin_cmd")" ]] || return 1
        [[ -n "$plugin_cmd_actual" ]] && {
            [[ -n "$(verify_lint_cmd "$plugin_cmd_actual")" ]] || return 1
        }
    fi
    return 0 # relevant cmd defined, and present
}

plugin_invalidate() {
    local skip_this="$1"
    local new=()
    local item

    [[ -n $skip_this ]] || error_msg "plugin_invalidate() - no param"
    [[ ${#valid_plugins[@]} == 0 ]] && {
        error_msg "plugin_invalidate() - attempt to remove when valid_plugins empty"
    }
    for item in "${valid_plugins[@]}"; do
        [[ $item == "$skip_this" ]] || new+=("$item")
    done
    valid_plugins=("${new[@]}")
}

all_blockers_present() {
    local word
    local -a words
    read -ra words <<<"$1"
    for word in "${words[@]}"; do
        [[ $word == '&&' ]] && continue
        str_in_array "$word" "${valid_plugins[@]}" || return 1
    done
    return 0
}

parse_plugin_file() {
    local f_plugin="$1"
    local plugin_name="${f_plugin##*/}" # same but faster than basename
    local dbg_indent=$dbg_indent
    local priority_plugin
    local cmd_used
    local ext file_type

    # encapsulate all f_plugin variables, so that they dont leak
    local disabled_by=() # initiate as empty list
    local plugin_cmd plugin_cmd_actual proj_plugin_cmd
    local plugin_priority=50 # set a default priority, higher prios are run first
    local plugin_extensions plugin_file_types

    # shell check disable=SC2034 # not used but needs to be contained from leaking
    local ruff_change_code="$ruff_change_code"
    local shfmt_change_code="$shfmt_change_code"
    # shell check disable=SC2034 # not used but needs to be contained from leaking
    local use_isort_style_import_ordering="$use_isort_style_import_ordering"

    [[ -z $f_plugin ]] && {
        error_msg "parse_plugin_file() - No param"
    }
    log_it "parse_plugin_file($f_plugin)" "$dbglvl_all_detils"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    source_file "$f_plugin" || return 1

    for priority_plugin in "${disabled_by[@]}"; do
        # skip this if listed item(s) making this redundant are present
        # needs to be done in 2nd pass, to know if the disabled_by items are
        # present. "a && b" requires all, a single name just that one
        all_blockers_present "$priority_plugin" && {
            log_it "$plugin_name is disabled by $priority_plugin" 2 # "$dbglvl_lintscan_details"
            plugin_invalidate "$plugin_name"
            return 1
        }
    done

    # Save priorities before figuring out if it is a project or file linter
    linter_priorities["$plugin_name"]="$plugin_priority"

    if [[ " ${project_linters[*]} " == *" $plugin_name "* ]]; then
        # Handle as project linter
        proj_linter_cmd["$plugin_name"]="$proj_plugin_cmd"
        proj_linters+=("$plugin_name")
        return 0
    fi

    #
    #  Handle it as a normal lint command
    #
    if [[ -n $plugin_cmd_actual ]]; then
        # if defined, this is the one to be used. prel_plugin_check() already
        # verified plugin_cmd and plugin_cmd_actual to be available
        cmd_used="$plugin_cmd_actual"
    else
        cmd_used="$plugin_cmd"
    fi
    linter_cmd["$plugin_name"]="$cmd_used"
    linter_order+=("$plugin_name")

    for ext in "${plugin_extensions[@]}"; do
        add_plugin_extension "$plugin_name" "$plugin_priority" "$ext"
    done

    for file_type in "${plugin_file_types[@]}"; do
        add_plugin_file_type "$plugin_name" "$(lowercase_it "$file_type")"
    done
    return 0
}

add_plugin_extension() {
    local dbg_indent=$dbg_indent
    local plugin="$1"
    local plugin_priority="$2"
    local ext="$3"
    local item
    local unsorted

    log_it "add_plugin_extension($plugin, $plugin_priority, $ext)" \
        "$((dbglvl_lintscan_basic + 2))"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns
    if [[ -z ${linter_extensions[$ext]} ]]; then
        linter_extensions[$ext]="$plugin"
    else
        for item in ${linter_extensions[$ext]}; do
            [[ $item = "$plugin" ]] && return 0
        done
        linter_extensions[$ext]+=" $plugin"

        unsorted=()
        for itm in ${linter_extensions[$ext]}; do
            unsorted+=("$itm")
        done
        linter_extensions[$ext]="$(sort_linters unsorted)"
    fi
}

add_plugin_file_type() {
    local dbg_indent=$dbg_indent
    local plugin="$1"
    local file_type="$2"
    local item

    lc_file_type="${file_type,,}"
    log_it "add_plugin_file_type($plugin, $lc_file_type)" \
        "$dbglvl_lintscan_details"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    if [[ -z "${linter_file_types[$lc_file_type]}" ]]; then
        linter_file_types[$lc_file_type]="$plugin"
    else
        for item in ${linter_file_types[$lc_file_type]}; do
            [[ "$item" = "$plugin" ]] && return 0
        done
        linter_file_types[$lc_file_type]+=" $plugin"

        unsorted=()
        for itm in ${linter_file_types[$lc_file_type]}; do
            unsorted+=("$itm")
        done

        sorted_items="$(sort_linters unsorted)"
        linter_file_types[$lc_file_type]="$sorted_items"
    fi
}

do_parse_linter_def() {
    #
    #  Handles the different notations
    #   linter_cmd
    #   linter_cmd -with -options
    #   ""
    #   prints the verified command if found or ""
    #
    local dbg_indent=$dbg_indent
    local lint_cmd="$1"
    local cmd
    local options
    local verif_cmd

    log_it "do_parse_linter_def($lint_cmd)" "$dbglvl_all_detils"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns
    if [[ -z "$lint_cmd" ]]; then
        cmd=""
        options=""
    elif [[ "${lint_cmd%"${lint_cmd#?}"}" = "-" ]]; then
        error_msg "linter cmd starts with  [$lint_cmd]" -1
        cmd=""
        options=""
    else
        cmd="$(echo "$lint_cmd" | cut -d' ' -f1)"
        options="$(echo "$lint_cmd" | cut -d' ' -f2-)"
    fi

    # if there were no options they will be the same
    [[ "$options" = "$cmd" ]] && options=""

    if [[ -n "$cmd" ]]; then
        verif_cmd="$(command -v "$cmd")" || {
            verif_cmd=""
        }
    else
        verif_cmd=""
    fi
    [[ -z "$verif_cmd" ]] && {
        cmd=""
        options=""
    }

    [[ -n "$verif_cmd" ]] && [[ -n "$options" ]] \
        && verif_cmd="$verif_cmd $options"
    echo "$verif_cmd"
    return 0
}

verify_lint_cmd() {
    local dbg_indent=$dbg_indent
    local lint_cmd="$1"
    local cmd_parsed

    log_it "verify_lint_cmd($lint_cmd)" "$dbglvl_all_detils"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    if cmd_parsed="$(do_parse_linter_def "$lint_cmd")"; then
        echo "$cmd_parsed"
    else
        error_msg "Failed to parse lint cmd: $lint_cmd"
    fi
    # log_it "result [$cmd_parsed]" "$dbglvl_lintscan_details"
}

sort_linters() {
    # Function to sort linters based on priorities
    local -n linters_array=$1
    local sorted_linters=()

    log_it "sort_linters(${linters_array[*]})" "$dbglvl_all_detils"

    if [[ "$running_on_ish" -eq 1 ]]; then
        #
        #  iSH kernel doesn't support enough of /proc to make mapfile work
        #
        # shellcheck disable=SC2207
        sorted_linters=($(
            for linter2 in "${linters_array[@]}"; do
                echo "$linter2 ${linter_priorities[$linter2]}"
            done | sort -k2nr | awk '{print $1}'
        ))
    else
        mapfile -t sorted_linters < <(
            # shellcheck disable=SC2030 # intentional subshell
            for linter2 in "${linters_array[@]}"; do
                echo "$linter2 ${linter_priorities[$linter2]}"
            done | sort -k2nr | awk '{print $1}'
        )
    fi
    echo "${sorted_linters[@]}"
}

#---------------------------------------------------------------
#
#   Linting actions
#
#---------------------------------------------------------------

update_linter_statistics() {
    local t_lint_start_d="$1"
    local t_usu_time_span

    log_it "update_linter_statistics() $t_lint_start_d"

    linter_usage_count["$linter"]=$((${linter_usage_count["$linter"]:-0} + 1))
    [[ $linter_statistics -eq 2 ]] && {
        [[ -n $t_lint_start_d ]] || error_msg "update_linter_statistics() - no param"
        time_span "$t_lint_start_d"
        if [[ -n ${linter_usage_time["$linter"]} ]]; then
            linter_usage_time["$linter"]=$(awk \
                -v a="${linter_usage_time["$linter"]}" \
                -v b="$t_usu_time_span" \
                'BEGIN { print a + b }')
        else
            linter_usage_time["$linter"]="$t_usu_time_span"
        fi
    }
}

lint_file() {
    local linter="$1"
    local fname="$2"
    local lint_pid
    local lint_exit_status
    local t_lint_start_d

    log_it "lint_file($linter, $fname)" "$dbglvl_lint_file_basic"
    log_it " running: ${linter_cmd["$linter"]} $fname" "$dbglvl_lint_file"

    #
    #  In order to avoid some linters untrapping Ctrl-C
    #  they are run in the background. Then some code to ensure the
    #  exit code of the linter is captured
    #
    [[ $linter_statistics -eq 2 ]] && safe_now t_lint_start_d
    eval "${linter_cmd["$linter"]}" "$fname" >"$f_linter_output" 2>&1 &
    lint_pid=$!
    wait "$lint_pid"
    lint_exit_status=$?

    if [[ "$lint_exit_status" -eq 0 ]]; then
        [[ $linter_statistics -gt 0 ]] && update_linter_statistics "$t_lint_start_d"
        return 0
    else
        printf '\n\n' # start error display on new line
        if [[ "$(wc -l <"$f_linter_output")" -gt 30 ]]; then
            #
            # prepending output with linter and file name, since when
            # displaying output in fullecreen the previous lines indicating
            # those details are not visible
            #
            printf '0a\nLinting command:\n%s\nFile: %s\n\n.\nw\n' \
                "${linter_cmd["$linter"]}" "$fname" | ed -s "$f_linter_output"
            less -R "$f_linter_output"
        else
            cat "$f_linter_output"
        fi
        handle_linting_error
    fi
    return 1
}

lint_by_ext() {
    local dbg_indent=$dbg_indent
    local fname="$1"
    local extension
    local b_linter_found
    local linter_found_issue
    local linter
    local t_lint_start

    log_it "lint_by_ext($fname)" "$dbglvl_lintscan_details"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    extension="${fname##*.}"
    if [[ "$extension" != "$fname" ]]; then
        extension=".$extension"
    else
        return 1 # False - next linter
    fi
    case "$extension" in
        *"/"*) return 1 ;; # . was in part of path
        *) ;;
    esac

    b_linter_found=false
    [[ -n "$extension" ]] && {
        #
        #  Processing by extension
        #
        linter_found_issue=false
        for linter in ${linter_extensions[$extension]}; do
            [[ -z ${linter_cmd["$linter"]} ]] && {
                # linter has been disabled
                continue
            }
            b_linter_found=true
            $b_lint_files || {
                log_it "$not_linting_msg" "$dbglvl_lint_file_basic"
                return 0 # True - next file
            }
            show_linter_action "$linter" "$fname"
            lint_file "$linter" "$fname" || linter_found_issue=true
            show_linter_time
            file_linters_done["$linter"]=1
        done
        if $b_linter_found; then
            log_it "processed by ext handler - $fname" "$dbglvl_lintscan_details"
            $linter_found_issue && file_has_issue=true
            return 0 # True - next file
        fi
    }
    return 1 # False - next linter
}

lint_by_file_type() {
    local dbg_indent=$dbg_indent
    local file_type="$1"
    local fname="$2"
    local linter_found_issue
    local b_linter_found
    local lf_type
    local linter

    log_it "lint_by_file_type($file_type, $fname)" "$dbglvl_lintscan_basic"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    linter_found_issue=false
    b_linter_found=false
    for lf_type in "${!linter_file_types[@]}"; do
        # shellcheck disable=SC2053
        [[ "$file_type" == $lf_type ]] || {
            continue
        }
        # iterate over linters matching lf_type
        for linter in ${linter_file_types[$lf_type]}; do
            [[ -z ${linter_cmd["$linter"]} ]] && {
                # linter has been disabled
                continue
            }
            # already run for this file, when it was matched by extension
            [[ -n ${file_linters_done["$linter"]} ]] && continue
            b_linter_found=true
            $b_lint_files || {
                log_it "$not_linting_msg" "$dbglvl_lint_file_basic"
                return 0 # True - next file
            }
            [[ "$running_on_ish" -eq 1 ]] && ish_sysload_check
            show_linter_action "$linter" "$fname"
            lint_file "$linter" "$fname" || linter_found_issue=true
            show_linter_time
            file_linters_done["$linter"]=1

            # not needed for visual inspection, but might be handy for
            # log analysis to get both lf_type and linter in one line
            log_it "processed as '$lf_type' - $linter" 9
        done
    done
    if $b_linter_found; then
        $linter_found_issue && file_has_issue=true
        return 0 # True - next file
    fi
    log_it "Unsupported file_type - $file_type" "$dbglvl_lint_file_basic"
    return 1 # False - next file_type

}

lint_proj() {
    local linter="$1"
    local role="${2:-post}"
    local lint_pid
    local lint_exit_status
    local label
    local t_lint_start_d

    log_it "lint_proj($linter)" "$dbglvl_lint_file_basic"
    log_it " running: ${proj_linter_cmd["$linter"]}" "$dbglvl_lint_file"

    case "$role" in
        pre) label="entire project - pre file loop" ;;
        *) label="entire project - post file loop" ;;
    esac
    show_linter_action "$linter" "=====  $label  ====="
    #
    #  In order to avoid some linters untrapping Ctrl-C
    #  they are run in the background. Then some code to ensure the
    #  exit code of the linter is captured
    #
    [[ $linter_statistics -eq 2 ]] && safe_now t_lint_start_d
    eval "${proj_linter_cmd["$linter"]}" >"$f_linter_output" 2>&1 &
    lint_pid=$!
    wait "$lint_pid"
    lint_exit_status=$?

    if [[ "$lint_exit_status" -eq 0 ]]; then
        [[ $linter_statistics -gt 0 ]] && update_linter_statistics "$t_lint_start_d"
        show_linter_time "proj"
        proj_lint_tasks_completed+=" $linter"
        return 0
    else
        if [[ "$(wc -l <"$f_linter_output")" -gt 30 ]]; then
            #
            # prepending output with linter name, since when displaying
            # output in fullecreen the previous lines indicating such is not
            # visible
            #
            printf '0a\nProject linter used:\n%s\n\n.\nw\n' \
                "${proj_linter_cmd["$linter"]}" | ed -s "$f_linter_output"
            less -R "$f_linter_output"
        else
            cat "$f_linter_output"
        fi
        handle_linting_error
    fi
    $b_lint_continue && return 0
    return 1
}

handle_linting_error() {
    #
    #  Either write out already processed files to cache and then exit
    #  or continue based upon
    #
    log_it "handle_linting_error()" "$dbglvl_major_tasks"
    $b_lint_continue && return
    env_cleanup 2
}

log_processing_statistics() {
    local l_fname
    if [[ -n "$1" ]]; then
        l_fname="$1" # if param is provided use instead of fname
    else
        l_fname="$fname"
    fi
    # printf 'linter: %s \t%s \t%s\n' "$duration" "$linter" "$fname"
    sql_log_lint_stats "$linter" "$l_fname" "$duration"
}

#---------------------------------------------------------------
#
#   Process files
#
#---------------------------------------------------------------

generate_list_of_files_to_process() {
    local max_age
    #
    #  Sets all_files to be a reverse chronological order list
    #  of all files in the current file tree
    #
    log_it "generate_list_of_files_to_process()" "$dbglvl_data_types"

    [[ "$verbosity_lvl" -ge 1 ]] && printf "Generating sorted tree of all files..."

    if [[ $max_age_mins -eq 0 ]]; then
        max_age=""
    else
        max_age="-mmin -$max_age_mins"
    fi

    # should work on all platforms
    # shellcheck disable=SC2086 # max_age needs to be unquoted
    files_out=$(find . -type f $max_age -exec ls -1t {} + | sed 's#^\./##')
    all_files=()
    [[ -n $files_out ]] && mapfile -t all_files <<<"$files_out"

    [[ "$verbosity_lvl" -ge 1 ]] && echo "done!"
}

should_fname_be_excluded() {
    #
    #  Check if fname matches exclusion rules
    #
    local fname="$1"
    local item pattern rel_fname

    [[ -z "$fname" ]] && {
        error_msg "should_fname_be_excluded() - called with empty fname"
    }

    $b_skip_common_excludes && {
        for item in "${hidden_patterns[@]}"; do
            [[ "$fname" == "$item"* ]] && return 0
        done
    }

    # Check if the filename matches any pattern
    for pattern in "${excluded_prefixes[@]}"; do
        [[ "$fname" == "$pattern"* ]] && {
            $b_show_excluded && show_excluded_file "prefix" "$fname"
            return 0
        }
    done

    for item in "${excluded_suffixes[@]}"; do
        [[ "$fname" = *"$item" ]] && {
            $b_show_excluded && show_excluded_file "suffix" "$fname"
            return 0
        }
    done

    for item in "${excludes[@]}"; do
        [[ "$fname" = "$item" ]] && {
            $b_show_excluded && show_excluded_file "excludes" "$fname"
            return 0
        }
    done

    rel_fname="${fname##*/}" # same but faster than basename
    for item in "${excluded_basenames[@]}"; do
        [[ "$rel_fname" = "$item" ]] && {
            $b_show_excluded && show_excluded_file "basename" "$fname"
            return 0
        }
    done

    for item in "${excluded_basename_prefixes[@]}"; do
        [[ "$rel_fname" = "$item"* ]] && {
            $b_show_excluded && {
                show_excluded_file "basename prefix" "$fname"
            }
            return 0
        }
    done

    return 1
}

ish_sysload_check() {
    # iSH crashes if sysload goes up too much, this pauses
    # until load is reasonable

    [[ -z "$ish_ift_uptime" ]] && return

    while [[ "$($ish_ift_uptime -l | cut -d. -f1)" -ge "$ish_max_load" ]]; do
        uptime_1min=$($ish_ift_uptime -l | cut -d, -f1)
        printf -- '---[%s]  ***  iSH sysload (%s) is > %s, waiting %ds  ***\n' \
            "$(date +'%F %T')" \
            "$uptime_1min" \
            "$ish_max_load" \
            "$ish_high_load_sleep"
        sleep "$ish_high_load_sleep"
    done
}

handle_project_linters() {
    local role="$1"

    for linter_name in "${proj_linters[@]}"; do
        case "$role" in
            pre)
                # Only code modifying project linters are done before the file loop
                [[ ${linter_priorities[$linter_name]} -lt 100 ]] && continue
                ;;
            post)
                [[ "$cache_written_during_proj_linters" -ne 1 ]] && {
                    # the cache doesn't update during proj linting, but if it takes ages
                    # on a slow system, it still makes sense to do one last flush
                    maybe_update_cache && cache_written_during_proj_linters=1
                }
                # Non code modyfing linters
                [[ ${linter_priorities[$linter_name]} -ge 100 ]] && continue
                ;;
            *) error_msg "proj_linters() called with bad param: $role" ;;
        esac

        [[ "$running_on_ish" -eq 1 ]] && ish_sysload_check
        lint_proj "$linter_name" "$role"
    done
}

process_file_tree() {
    #
    #  Loop over all files, sorted by file age, newest first.
    #  Then identifying filetype using: file -b
    #  grouping by type, and linting files suitable for such
    #  as they come up. Thereby minimizing pointless wait time, since
    #  the file tree is globally sorted by age
    #
    local dbg_indent=$dbg_indent
    local all_files
    local fname
    local b_linter_found
    local file_types
    local file_type
    local cache_written_during_proj_linters=0

    log_it "process_file_tree()" "$dbglvl_major_tasks"
    dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

    $b_lint_files && ! $b_proj_linters_skip && ! $b_show_excluded \
        && [[ ${#proj_linters[@]} -gt 0 ]] && {
        #  project linters with priority >= 100, ie those that might alter code
        handle_project_linters pre
    }

    ! $b_proj_linters_only && {
        [[ "$running_on_ish" -eq 1 ]] && ish_sysload_check

        generate_list_of_files_to_process

        orig_dbg_indent=$dbg_indent
        cache_set_timer
        if $b_mime_type_limit; then
            file_cmd="file --mime-type -b"
        else
            file_cmd="file -b"
        fi

        for fname in "${all_files[@]}"; do
            dbg_indent=$orig_dbg_indent
            [[ -z "$fname" ]] && continue

            b_linter_found=false
            file_linters_done=()
            file_has_issue=false
            should_fname_be_excluded "$fname" && continue
            $b_show_excluded && continue # only show excluded files, dont lint anything

            log_it "Examining file: $fname" "$dbglvl_major_tasks"
            dbg_indent=$((dbg_indent + 1)) # increase indent until this returns

            $b_use_cache && filename_is_cached "$fname" && {
                $b_lint_files && log_it "no changes : $fname" "$dbglvl_no_changes"
                continue
            }

            #
            #  Processing by file extension
            #
            lint_by_ext "$fname" && {
                b_linter_found=true
                b_changed_file_found=true
            }

            #
            #  Processing by file type
            #
            IFS='|' read -r -a file_types <<<"$($file_cmd "$fname" \
                | tr '[:upper:]' '[:lower:]' | sed 's#, #|#g')"
            for file_type in "${file_types[@]}"; do
                [[ "$running_on_ish" -eq 1 ]] && ish_sysload_check
                lint_by_file_type "$file_type" "$fname" && {
                    b_linter_found=true
                    b_changed_file_found=true
                    break
                }
            done

            #  Only cache if nothing failed, for either extension or file type
            $b_lint_files && $b_linter_found && ! $file_has_issue && cache_add "$fname"
            $b_linter_found && continue

            # If we got here the file was neither linted nor excluded, so
            # porj linters if defined should be run
            b_changed_file_found=true

            $b_lint_files || {
                $b_linter_found || {
                    files_without_matching_linter=$((files_without_matching_linter + 1))
                    show_excluded_file "= No linter =" "$fname"
                }
            }
        done
    }

    #  project linters run after file tree is parsed
    $b_lint_files && ! $b_proj_linters_skip && ! $b_show_excluded \
        && $b_changed_file_found && [[ ${#proj_linters[@]} -gt 0 ]] && {
        #  project linters with priority < 100, ie those not altering code
        handle_project_linters post
    }

    [[ $files_without_matching_linter -gt 0 ]] && {
        echo
        echo "Found $files_without_matching_linter files with no linter defined"
    }
}

