#!/usr/bin/env bash
#  This is sourced. Fake bang-path to help editors and linters
#  shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Checks Ansible playbooks and roles for practices and behaviour.
# Strengths:
#  Knows Ansible-specific rules that generic YAML tools cannot check.
# Use case:
#  Projects that contain Ansible content.
# Caveats:
#  Slow and comprehensive, so it runs late. Crashes on iSH.

# Installation methods;
# Not usable on iSH - crashes - last checked: 26-08-18
#  brew install ansible-lint
#  (Ubuntu) sudo apt install ansible-lint
#  (Alpine) sudo apk add ansible-lint
#        crashes on iSH as of 25-04-19

# project config files: .ansible-lint.yml
#  ---
#  rules:
#    skip:
#      - ANSIBLE0012

plugin_cmd=ansible-lint
proj_plugin_cmd=ansible-lint

plugin_priority=5

plugin_extensions=(
    .yml
    .yaml
)
