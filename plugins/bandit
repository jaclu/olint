#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Security-focused linter for Python.
# Strengths:
#  Identifies security vulnerabilities, e.g. usage of insecure functions or
#  libraries.
# Use case:
#  Essential for projects where security is a concern.
# Caveats:
#  Reports possible issues, not confirmed ones, so some findings will be false
#  positives. Reviewed lines can be silenced with # nosec.

# Installation methods;
#  pip install bandit  # usable on iSH
#  brew install bandit
#  (Ubuntu) sudo apt install bandit

# inline-excludes:  # nosec

plugin_cmd=bandit
proj_plugin_cmd="bandit --exclude './.venv' -r ."

plugin_priority=45

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
