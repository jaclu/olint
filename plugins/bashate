#!/usr/bin/env bash
#  This is sourced. Fake bang-path to help editors and linters
#  shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Code style enforcement for bash programs.
# Strengths:
#  Much faster than shellcheck. Checks layout rules, such as indentation and
#  line length, that shellcheck does not cover.
# Use case:
#  Enforces a consistent layout across shell scripts.
# Caveats:
#  Run after shellcheck: a missing } is reported as an unexpected end of file,
#  which is unclear. Project settings are read from .bashateconfig by
#  bashate_wrapper. Rules that shfmt handles (E003, E010, E011, E020) are
#  ignored, so the two do not contradict each other.

# Installation methods;
#  pip3 install bashate  # usable on iSH
#  brew install bashate
#  (Ubuntu) sudo apt install python3-bashate

# bashate doesn't have a config file, so I created one!
# and included bashate_wrapper. This is called by olint to first parse
# this config then run bashate
# project config file: .bashateconfig
#  max-line-length=92
#  ignore=E001,E002

bashate_wrapper() {
    local config_file=".bashateconfig"
    local max_line_length="" ignore=""
    # shfmt-compatible baseline, project config adds to it
    local base_ignore="E003,E010,E011,E020"

    if [[ -f $config_file ]]; then
        max_line_length=$(sed -n 's/^max-line-length=//p' "$config_file")
        ignore=$(sed -n 's/^ignore=//p' "$config_file")
    fi

    bashate -e E005,E042,E043,E044 \
        --max-line-length "${max_line_length:-80}" \
        --ignore "$base_ignore${ignore:+,$ignore}" \
        "$@"
}

# Always run, bashate_wrapper ignores the rules shfmt handles, so they never
# conflict with shfmt, and it applies the project config, like line-length etc
# plugin_cmd is the linter being checked for presence, and plugin_cmd_actual is
# the wrapper func in-here that first parses the proj config file
plugin_cmd=bashate
plugin_cmd_actual=bashate_wrapper
# not usable as a project linter, it does not accept a directory
proj_plugin_cmd=/dev/null

# much faster than shellcheck, but in a few corner cases will fail to
# give a meaningful error. such as missing a } somewhere will just
# be reported as unexpected end of file.
# so better to run after shellcheck
plugin_priority=57

plugin_extensions=(
    .bash
    .sh
)

plugin_file_types=(
    "Bourne-Again shell script*"
    "Paul Falstad's zsh script*"

    "a *openrc-run script*"
)
