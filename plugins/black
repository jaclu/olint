#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Code formatter for Python. Be aware: Modifies the code!
# Strengths:
#  Enforces consistent formatting across your codebase.
# Use case:
#  Projects that want a fixed Python layout without deciding it manually.
# Caveats:
#  Skipped if ruff-format is found, since both do the same job and they
#  disagree in some cases.

# Installation methods;
#  pip install black  # usable on iSH
#  brew install black
#  (Ubuntu) sudo apt install black
#  (Alpine) sudo apk add black

# inline-excludes:  # fmt: skip
# line above a block: # fmt: off
# line after a blick: # fmt: on
# project config files: pyproject.toml $XDG_CONFIG_HOME/black (~/.config/ if not set)
#  [tool.black]
# Handle entire project, sample pyproject.toml block:
#
# [tool.black]
# line-length = 92
# exclude = '''
# /(
#     \.venv    # Match .venv directory
# )/
# '''

# Skipped if any of these plugins are used, even when this plugin is installed
disabled_by=(ruff-format)

plugin_cmd=black
proj_plugin_cmd="black ."

plugin_priority=101

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
