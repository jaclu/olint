#!/usr/bin/env bash
#  This is sourced. Fake bang-path to help editors and linters
#  shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Find common misspellings in source code and text files. Reports only, it
#  does not fix anything.
# Strengths:
#  Fast and low on noise. Works on any text file, not only code.
# Use case:
#  Catching typos in comments, docs and identifiers across a project.
# Caveats:
#  Project linter only, since there is no file type to match on. Can flag
#  valid words, which can be accepted with override_linter_cmd.

# Installation methods;
#  pip install codespell  # usable on iSH
#  brew install codespell
#  (Ubuntu) sudo apt install codespell
#  (Alpine) sudo apk add py3-codespell

# if there are terms that should be accepted
# override_linter_cmd["codespell"]="codespell -L THIS"
#
# If there are files that should not be linted by codespell, add this
# override_linter_cmd["codespell"]="codespell -S file1,file2"

# This is not really meaningful to run on a per file basis, since
# there isn't any file type associated, so in the clobal config this
# is set as a project linter.

proj_plugin_cmd="codespell -H -S './.git,./.venv,./.mypy_cache,./.ruff_cache'"

# text-only check, it does not analyze code, so it runs after the code analyzers
plugin_priority=55
