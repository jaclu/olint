#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables
#
# Flake8 also provides: pyflakes, pycodestyle, McCabe
# so it would be redundant to also run them if you use Flake8
#

# Purpose:
#  Lightweight tool for enforcing PEP 8 style and detecting common coding
#  issues.
# Strengths:
#  Supports plugins for extended functionality (e.g., flake8-bugbear for
#  additional checks). Less verbose than Pylint.
# Use case:
#  Projects that want PEP 8 style plus common bug checks without the weight of
#  Pylint.
# Caveats:
#  Skipped if ruff-check is found. Bundles pyflakes, pycodestyle and McCabe,
#  so running those alongside it is redundant.

# Installation methods;
#  pip install flake8
#  brew install flake8
#  (Ubuntu) sudo apt install flake8
#  (Alpine) sudo apk add py3-flake8

# inline-excludes:  # noqa: F841
# project config files: setup.cfg
#  [flake8]
#  max-line-length = 92

# Not run if any of these commands are found, even when this plugin is installed
disabled_by=(ruff-check)

# avoiding parallelism is normally not a performance bottle neck
# and avoids flake8 to fail on limited systems
plugin_cmd="flake8 --jobs=1"
proj_plugin_cmd="$plugin_cmd --exclude './.venv'"

# iSH doesn't support flake8 multiprocessing
[[ -d /proc/ish ]] && proj_plugin_cmd+=" -j 1"

plugin_priority=44

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
