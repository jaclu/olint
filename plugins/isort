#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Checks and formats import statements. Be aware: Modifies the code!
# Strengths:
#  Ensures imports are grouped and ordered correctly according to PEP 8.
# Use case:
#  Keeps imports organized and clean.
# Caveats:
#  Skipped if ruff-check is found, unless use_isort_style_import_ordering=1.
#  Ruff's import ordering can conflict with isort. If nodes in a project use
#  different tools, set use_isort_style_import_ordering=1 in the project
#  config to avoid conflicting changes.

# Installation methods;
#  pip install isort  # usable on iSH
#  brew install isort
#  (Ubuntu) sudo apt install isort
#  (Alpine) sudo apk add py3-isort

# use_isort_style_import_ordering is supplied via config when applicable.
# shellcheck disable=SC2154
[[ "$use_isort_style_import_ordering" -ne 1 ]] && skip_if_used=(ruff-check)

plugin_cmd=isort
proj_plugin_cmd="isort --gitignore ."

plugin_priority=130

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
