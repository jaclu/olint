#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Checks and formats import statements. Be aware: Modifies the code!
# Strengths:
#  Ensures imports are grouped and ordered correctly according to PEP 8.
# Use case:
#  Keeps imports organized and clean.
# Caveats:
#  Controlled by use_isort_style_import_ordering in olint.conf (global) or
#  .olint.conf (project):
#    0  (default) used only if ruff-check is not found
#    1  isort ordering wanted, ruff-check is disabled if it conflicts with it
#   -1  isort ordering not wanted, isort is never used
#  Ruff's import ordering can conflict with isort, so set it to avoid
#  conflicting changes.

# Installation methods;
#  pip install isort  # usable on iSH
#  brew install isort
#  (Ubuntu) sudo apt install isort
#  (Alpine) sudo apk add py3-isort

# use_isort_style_import_ordering is supplied via config when applicable.
# shellcheck disable=SC2154
if [[ "$use_isort_style_import_ordering" -eq -1 ]]; then
    # isort ordering explicitly not wanted, so isort is never used
    plugin_cmd=/dev/null
    proj_plugin_cmd=/dev/null
    return 0
else
    plugin_cmd=isort
    proj_plugin_cmd="isort --gitignore ."
fi

[[ "$use_isort_style_import_ordering" -ne 1 ]] && {
    # Not run if any of these commands are found, even when this plugin is installed
    disabled_by=(ruff-check)
}

plugin_priority=130

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
