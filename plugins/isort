#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Checks and formats import statements. - Be aware: Modifies the code!
# Strengths:
#  Ensures imports are grouped and ordered correctly according to PEP 8.
# Use case:
#  Keeps imports organized and clean.
# Caveats:
#  Baseline is to skip isort if ruff-check is found.
#  isort conflicts with some versions of ruff for import ordering
#  If project is linted on nodes where some use isort and othets ruff-check
#  it is recommended to set use_isort_style_import_ordering=1 in proj config
#  to skip ruff versions that will collide with isort sort order

# Installation methods;
#  pip install isort  # usable on iSH
#  brew install isort
#  (Ubuntu) sudo apt install isort
#  (Alpine) sudo apk add py3-isort

skip_if_used=(ruff-check)

plugin_cmd=isort
proj_plugin_cmd="isort --gitignore ."

plugin_priority=115

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
