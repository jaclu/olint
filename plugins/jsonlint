#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  JSON file linter.
# Strengths:
#  Quick syntax validation for JSON files.
# Use case:
#  Catching malformed JSON before a tool that reads it fails on it.
# Caveats:
#  Not run as a project linter, since it would idle forever. Ignores Ctrl-C,
#  which is not solved yet.

# Installation methods;
#   brew install jsonlint
#   pip3 install jsonlint (installs but doesn't seem to provide any binary)
#   (Ubuntu)
#      sudo apt install nodejs npm
#      sudo npm install -g jsonlint

plugin_cmd="jsonlint -p"
# If run as a project linter, the process does nothing and idles forever...
proj_plugin_cmd=/dev/null

plugin_priority=47

plugin_extensions=(
    .json
)

plugin_file_types=(
    "JSON data"
    "JSON text data"
)
