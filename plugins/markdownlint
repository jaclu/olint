#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Linter for Markdown files.
# Strengths:
#  Checks Markdown against a set of rules, configurable via
#  .markdownlint.yaml.
#  sample: https://github.com/DavidAnson/markdownlint/blob/main/schema/.markdownlint.yaml
# Use case:
#  Keeping README and other Markdown documents consistent.
# Caveats:
#  Shares the .markdownlint.yaml config with markdownlint-cli2.
#  Skipped if markdownlint-cli2 or rumdl is found.

# Installation methods;
#  brew install markdownlint-cli
#  (Ubuntu)
#  apt install markdownlint

# Not run if any of these commands are found, even when this plugin is installed
disabled_by=(markdownlint-cli2 rumdl)

plugin_cmd=markdownlint
proj_plugin_cmd="markdownlint ."

plugin_priority=42

plugin_extensions=(
    .md
)
