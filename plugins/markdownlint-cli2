#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Linter for Markdown files.
# Strengths:
#  Uses the same rules as markdownlint, so results match.
# Use case:
#  Projects with Markdown documents where markdownlint-cli2 is available.
# Caveats:
#  Shares the .markdownlint.yaml config with markdownlint.

# Installation methods;
#  For python, consider pymarkdown
#  brew install markdownlint-cli2

# project config file: .markdownlint.yaml

plugin_cmd=markdownlint-cli2
proj_plugin_cmd="markdownlint-cli2 \"**.{md,markdown}\""

plugin_priority=42

plugin_extensions=(
    .md
)
