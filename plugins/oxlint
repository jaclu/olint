plugin_cmd="oxlint --fix"
proj_plugin_cmd="rslint ."

plugin_priority=95

plugin_extensions=(
    .js
    .mjs
    .cjs
    .jsx
    .ts
    .mts
    .cts
    .tsx
    .vue
    .astro
    .svelte
)

plugin_file_types=(
)
