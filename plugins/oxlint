#!/usr/bin/env bash
# shellcheck disable=SC2034

# Purpose:
#  High-performance linter for JavaScript and TypeScript, written in Rust. Be
#  aware: Modifies the code!
# Strengths:
#  Very fast, with a large set of built-in rules.
# Use case:
#  JavaScript and TypeScript projects.
# Caveats:
#  Fixes are applied on every run, there is no check-only mode in this plugin.

# Installing methods;
#  brew install oxlint
#  Manual
#    pnpm add -D oxlint

# project config files:
#  .oxlintrc.json

plugin_cmd="oxlint --fix"
proj_plugin_cmd="rslint ."

# Modifies the code, so it runs in the source-modifying range, before analysis
plugin_priority=105

plugin_extensions=(
    .js
    .mjs
    .cjs
    .jsx
    .ts
    .mts
    .cts
    .tsx
    .vue
    .astro
    .svelte
)

plugin_file_types=(
)
