#!/usr/bin/env bash
# shellcheck disable=SC2034

# Purpose:
#  High-performance linter for JavaScript and TypeScript written in Rust
# Strengths:
# Use case:
# Caveats:

# Installing methods;
#  brew install oxlint
#  Manual
#    pnpm add -D oxlint

# project config files:
