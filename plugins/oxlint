#!/usr/bin/env bash
# shellcheck disable=SC2034

# Purpose:
#  High-performance linter for JavaScript and TypeScript, written in Rust. Be
#  aware: Modifies the code!
# Strengths:
#  Very fast, with a large set of built-in rules.
# Use case:
#  JavaScript and TypeScript projects.
# Caveats:
#  Fixes are applied on every run, there is no check-only mode in this plugin.

# Installing methods;
#  brew install oxlint
#  Manual
#    pnpm add -D oxlint

# project config files:
#  .oxlintrc.json

# shellcheck disable=SC2154 # oxlint_change_code is supplied via config when applicable.
if [[ "$oxlint_change_code" = 1 ]]; then
    plugin_cmd="oxlint --fix"
    plugin_priority=105
else
    plugin_cmd="oxlint"
    plugin_priority=65
fi
proj_plugin_cmd="$plugin_cmd ."

plugin_extensions=(
    .js
    .mjs
    .cjs
    .jsx
    .ts
    .mts
    .cts
    .tsx
    .vue
    .astro
    .svelte
)

plugin_file_types=(
)
