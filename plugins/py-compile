#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Compiles the module to ensure syntactic correctness. An initial test, but
#  says nothing about good coding style.
# Strengths:
#  Very fast, uses only the Python standard library.
# Use case:
#  Rapid validation: if the code can't even be compiled, there is not much
#  point in running linters on it.
# Caveats:
#  Only detects syntax errors, nothing about style or logic.

plugin_cmd="python3 -m py_compile"
proj_plugin_cmd=/dev/null # not usable as a project linter, it does not accept a directory

# really fast so run early
plugin_priority=210

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
