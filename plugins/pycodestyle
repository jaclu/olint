#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  PEP 8 style checker.
# Strengths:
#  Focused on style only, lightweight and needs no config to start.
# Use case:
#  Enforcing PEP 8 on projects that do not use flake8 or ruff.
# Caveats:
#  Redundant if flake8 is used. Skipped if ruff-check or flake8 is found.

# Installation methods;
#  pip install pycodestyle  # usable on iSH
#  brew install pycodestyle
#  (Ubuntu) sudo apt install pycodestyle
#  (Alpine) sudo apk add py3-pycodestyle

# inline-excludes:  # noqa: E402
# project config files: setup.cfg
#  [pycodestyle]
#  max-line-length = 92

skip_if_used=(ruff-check flake8)

plugin_cmd=pycodestyle
proj_plugin_cmd="pycodestyle --exclude=.venv ."

plugin_priority=65

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
