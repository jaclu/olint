#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Lightweight linting: undefined names, unused imports etc. Static checker for
#  Python that looks for actual code errors, not formatting issues or style
#  violations.
# Strengths:
#  Very fast, and reports real errors without style noise.
# Use case:
#  Quick check for mistakes such as undefined names and unused imports.
# Caveats:
#  Not usable as a project linter, it has no exclude parameter.
#  Skipped if ruff-check or flake8 is found.

# Installation methods;
#  pip install pyflakes  # usable on iSH

#  (Ubuntu) sudo apt install pyflakes3
#  (Alpine) sudo apk add py3-pyflakes

# inline-excludes:  # noqa: F401,F403

# Skipped if any of these plugins are used, even when this plugin is installed
disabled_by=(ruff-check flake8)

plugin_cmd=pyflakes
# obviously there are two names it might use...
command -v pyflakes3 >/dev/null && plugin_cmd=pyflakes3

# not usable as a project linter, since it has no exclude parameter
proj_plugin_cmd=/dev/null

plugin_priority=85

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
