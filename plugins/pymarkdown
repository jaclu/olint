#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Python markdown linter, could be used when brew can not provide
#  markdownlint-cli2.
# Strengths:
#  Python based, so it fits projects that already use pip and need no Node.js.
# Use case:
#  Markdown linting where markdownlint-cli2 is not available.
# Caveats:
#  Typically has to be installed in a venv.
#  Uses its own config (pyproject.toml, .pymarkdown.yaml or .pymarkdown), not
#  .markdownlint.yaml.
#  Skipped if markdownlint-cli2 or markdownlint is found.

# Installation methods;
#  pip install pymarkdownlnt - Do NOT install pymarkdown pkg!

# project config files:

# pyproject.toml
# [tool.pymarkdown]
# plugins.MD013.enabled = true
# plugins.MD013.line_length = 92

# Or the more readable form:

# plugins.line-length.enabled = true
# plugins.line-length.line_length = 92

# .pymarkdown.yaml:
# ---
# plugins:
#   MD013:
#     enabled: true
#     line_length: 92

# .pymarkdown (JSON5)
# {
#     "plugins": {
#         "MD013": {
#             "enabled": true,
#             "line_length": 92
#         }
#     }
# }

skip_if_used=(markdownlint-cli2 markdownlint)

plugin_cmd="pymarkdown scan"
proj_plugin_cmd="$plugin_cmd -r ."

plugin_priority=42

plugin_extensions=(
    .md
)
