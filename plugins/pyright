#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Static type checker for Python.
# Strengths:
#  Overlaps with mypy but is less strict, making it more suitable for gradual
#  adoption of type hints. Be aware: For CLI pyright makes sense, in vscode
#  Pylance should be used, since it uses the pyright engine but offers better
#  integration.
# Use case:
#  Type checks for projects that prefer a less strict alternative to mypy.
# Caveats:
#  Skipped if mypy is found.

# Installation methods;
# Not usable on iSH - segfaults - last checked: 26-08-18
#  pip install pyright  # iSH can install but fails to run
#  brew install pyright
#  npm install -g pyright

# line above: # pyright: reportGeneralTypeIssues=false
# line above: # pyright: reportMissingImports=false
# project config file: pyrightconfig.json
# {
#     "exclude": [
#         ".venv",
#     ],
# }

# Not run if any of these commands are found, even when this plugin is installed
disabled_by=(mypy)

plugin_cmd=pyright
proj_plugin_cmd="$plugin_cmd ."

plugin_priority=30

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
