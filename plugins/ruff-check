#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Python linter, written in Rust. Checks code for correctness and style rule
#  violations. If ruff_change_code=1 it auto-fixes issues.
# Strengths:
#  Extremely fast. Its rules cover much of what flake8 (with plugins), isort,
#  pyupgrade and autoflake do, and it runs far faster than any of them.
# Use case:
#  Rapid linting of Python code for correctness and style problems.
# Caveats:
#  If use_isort_style_import_ordering=1 and rule I001 is active, this plugin
#  is disabled, to avoid changes that conflict with isort.

# Installation methods;
#  Not usable on iSH - segfaults - last checked: 26-08-18
#  pip install ruff  # dependency: rust  iSH can install but fails to run
#  brew install ruff
#  (Alpine) sudo apk add ruff # segfaults on iSH
#  (Termux) apt install ruff

# Sample config (pyproject.toml)
# F & BLE must be present to ensure ruff linting doesn't leave issues
# pylint would reject on nodes not using ruff
#
# [tool.ruff.lint]
# select = ["E", "W", "I", "UP", "F", "BLE"]

# inline-excludes:  # noqa: F403,F401

# shellcheck disable=SC2154 # ruff_change_code is supplied via config when applicable.
if [[ "$ruff_change_code" = 1 ]]; then
    plugin_cmd="ruff check --fix"
    proj_plugin_cmd="$plugin_cmd ."
    plugin_priority=145
else
    plugin_cmd="ruff check"
    proj_plugin_cmd="$plugin_cmd ."
    plugin_priority=90
fi

# use_isort_style_import_ordering is supplied via config when applicable.
# shellcheck disable=SC2154
if [[ "$use_isort_style_import_ordering" = 1 ]]; then
    case "$(ruff check --show-settings 2>/dev/null)" in
        *I001*)
            # ruff import order might conflict with isort, thus disabled
            plugin_cmd=/dev/null
            proj_plugin_cmd=/dev/null
            ;;
        *) ;;
    esac
fi

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
