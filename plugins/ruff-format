#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Python code formatter, written in Rust. Only handles formatting, lint rules
#  are left to ruff-check. Be aware: Modifies the code!
# Strengths:
#  Extremely fast. Output is designed to match Black's style, so layout is
#  consistent without debate.
# Use case:
#  Enforcing one consistent Python layout across a project, kept separate from
#  lint rules so each can be configured on its own.
# Caveats:
#  Rewrites files in place, this plugin has no check-only mode.

# Installation methods;
# Not usable on iSH - segfaults - last checked: 26-08-18
#  pip install ruff  # dependency: rust  iSH can install but fails to run
#  brew install ruff
#  (Alpine) sudo apk add ruff # segfaults on iSH

# Sample config (pyproject.toml)
# F & BLE must be present to ensure ruff linting doesn't leave issues
# pylint would reject on nodes not using ruff
#
# [tool.ruff.lint]
# select = ["E", "W", "I", "UP", "F", "BLE"]

# inline-excludes:  # noqa: F403,F401

plugin_cmd="ruff format"
proj_plugin_cmd="$plugin_cmd"

plugin_priority=120

plugin_extensions=(
    .py
    .py3
)

plugin_file_types=(
    "Python script*"
)
