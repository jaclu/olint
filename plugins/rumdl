#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables

# Purpose:
#  Linter and formatter for Markdown files.
# Strengths:
#  Very fast, and a single binary with no Node.js or Python runtime needed.
#  Can also fix issues when rumdl_change_code=1.
# Use case:
#  Markdown linting in projects that want a fast tool without Node.js.
# Caveats:
#  Does not work on iSH
#  Reads .rumdl.toml, pyproject.toml ([tool.rumdl]) or .markdownlint.yaml.

# Simple Installation methods;
#  pip install rumdl
#  brew install rumdl
#
# For Termux
#  Enable TUR repo first
#  pkg install tur-repo
#
#  Then install rumdl
#  pkg install rumdl
#
#  No pkgs for rpm/apt yet, but several install methods listed
# Installation:  https://rumdl.dev/getting-started/installation/
# Configuration hints: https://rumdl.dev/configuration/
#

# shellcheck disable=SC2154 # rumdl_change_code is supplied via config when applicable.
if [[ "$rumdl_change_code" = 1 ]]; then
    plugin_cmd="rumdl check --fix"
    plugin_priority=150
else
    plugin_cmd="rumdl check"
    plugin_priority=80
fi
proj_plugin_cmd="$plugin_cmd ."

plugin_extensions=(
    .md
)
