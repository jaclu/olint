#!/usr/bin/env bash
# This is sourced. Fake bang-path to help editors and linters
# shellcheck disable=SC2034  # don't warn about unused variables
#
# Purpose:
#  Lints TOML files for syntax and semantic errors, using taplo.
# Strengths:
#  Catches TOML syntax errors before tools that read the file fail on them.
# Use case:
#  Checking pyproject.toml, .taplo.toml and other TOML files in a project.
# Caveats:
#  Only lints. Formatting is done by taplo-format, which runs separately.

# Installation methods
#  brew install taplo
#  npm install -g @taplo/cli
#  yarn global add @taplo/cli
#  pnpm install -g @taplo/cli

# project config: .taplo.toml
# Global config: ~/.config/taplo/config.toml / $XDG_CONFIG_HOME/taplo/config.toml

#
# Reformat toml file: taplo format file.toml
#

plugin_cmd="taplo lint"
proj_plugin_cmd="$plugin_cmd ."

plugin_priority=74

plugin_extensions=(
    .toml
)
