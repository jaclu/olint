#!/usr/bin/env bash
# shellcheck disable=SC2034

# Purpose:
#  YAML syntax and style linting.
# Strengths:
#  Detects YAML syntax, structure, and formatting problems.
# Use case:
#  Generic YAML validation. Complements ansible-lint rather than replacing it.
# Caveats:
#  Runs with -s, so warnings count as errors.

# Installation methods;
#  pip install yamllint
#  brew install yamllint
#  (Ubuntu) sudo apt install yamllint
#  (Alpine) sudo apk add yamllint

# project config files: .yamllint
#  ---
#  extends: default
#  rules:
#    line-length:
#    max: 92
#    level: warning

plugin_cmd="yamllint -s" # -s trigger error on warnings
proj_plugin_cmd="$plugin_cmd ."

plugin_priority=60

plugin_extensions=(
    .yml
    .yaml
)

plugin_file_types=(
)
